# {{ ansible_managed }}
[mysqld]
server_id = {{ 1 if mysql_node == mysql_primary else 2 }}
bind-address = "{{ hostvars[mysql_node].loopback_ip }},127.0.0.1"
skip_name_resolve = ON
gtid_mode = ON
enforce_gtid_consistency = ON
log_bin
binlog_format = ROW
log_error_verbosity = 3
replica_net_timeout = 10
{% if mysql_node == mysql_primary %}
event_scheduler = ON
{% endif %}
