# {{ ansible_managed }}
name: {{ lab_project }}

networks:
{% for net, cfg in lab_networks.items() %}
  {{ net }}:
    internal: {{ cfg.internal | lower }}
    ipam:
      config:
        - subnet: {{ cfg.subnet }}
{% endfor %}

services:
{% for node in groups['nodes'] %}
{%   set hv = hostvars[node] %}
  {{ node }}:
    image: {{ node_image }}
    container_name: {{ node }}
    hostname: {{ node }}
    init: true
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      # FRR's zebra and bgpd refuse to start without it
      - SYS_ADMIN
    sysctls:
{%   for key, value in lab_sysctls.items() %}
      {{ key }}: "{{ value }}"
{%   endfor %}
    volumes:
      - ./nodes/{{ node }}:/etc/sos
      - {{ lab_run_dir }}/{{ node }}/frr:/var/run/frr
    labels:
      sos.site: "{{ hv.site }}"
      sos.role: "{{ 'mysql' if node in groups['mysql'] else 'relay' }}"
    networks:
{%   for net, ip in hv.lab_links.items() %}
      {{ net }}:
        ipv4_address: {{ ip }}
        interface_name: {{ lab_networks[net].ifname }}
{%     if net == 'mgmt' %}
        gw_priority: 100
{%     endif %}
{%   endfor %}
    healthcheck:
      test: ["CMD", "ip", "-4", "addr", "show", "dev", "dummy0"]
      interval: 5s
      timeout: 2s
      retries: 3
{% endfor %}
