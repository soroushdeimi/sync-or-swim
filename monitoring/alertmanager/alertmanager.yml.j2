# {{ ansible_managed }}
global:
  resolve_timeout: 5m
  smtp_smarthost: "{{ mgmt_services.mailpit }}:1025"
  smtp_from: "alertmanager@sync-or-swim.local"
  smtp_require_tls: false

route:
  group_by: [alertname, instance]
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 12h
  receiver: mailpit-default
  routes:
    - matchers:
        - severity = critical
      receiver: autodiagnose-webhook
      continue: true
    - matchers:
        - severity = critical
      repeat_interval: 1h
      receiver: mailpit-default

inhibit_rules:
  # With every path down these are symptoms of the same outage (the replica's IO thread cannot
  # connect, lag grows). MySQLUnreachable and ReplicationSQLStopped stay visible on purpose:
  # they are failures of the database itself, which a network outage must not hide.
  - source_matchers:
      - alertname = AllPathsDown
    target_matchers:
      - alertname =~ "BGPSessionDown|BFDPeerDown|PathHighPacketLoss|ReplicationIOStopped|ReplicationLagHigh"
    equal: []
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: [alertname, instance]

receivers:
  - name: mailpit-default
    email_configs:
      - to: "sre-team@sync-or-swim.local"
        send_resolved: true
  - name: autodiagnose-webhook
    webhook_configs:
      - url: "http://{{ mgmt_services['alert-webhook'] }}:9095/"
        send_resolved: false
