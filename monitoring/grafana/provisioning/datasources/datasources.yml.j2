# {{ ansible_managed }}
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://{{ mgmt_services.prometheus }}:9090
    isDefault: true
    editable: false

  - name: Loki
    type: loki
    access: proxy
    url: http://{{ mgmt_services.loki }}:3100
    isDefault: false
    editable: false
